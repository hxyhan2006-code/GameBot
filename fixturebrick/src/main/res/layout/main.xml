<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#0f131e">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Brick Test (GameBot)" android:textColor="#ffffff" android:textSize="24sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gamebot_test_hint" android:textColor="#cbd5e1" android:layout_marginTop="12dp"/>
  <Button android:id="@+id/button_newGame" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/button_newGame" android:onClick="clickNewGame" android:layout_marginTop="16dp"/>
  <Button android:id="@+id/button_resumeGame" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/button_resumeGame" android:onClick="clickResumeGame"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/difficulty" android:textColor="#cbd5e1" android:layout_marginTop="12dp"/>
  <Spinner android:id="@+id/spinner_difficultyLevel" android:layout_width="match_parent" android:layout_height="52dp" android:background="#334155"/>
  <CheckBox android:id="@+id/checkbox_neverLoseBall" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/checkbox_neverLoseBall" android:textColor="#cbd5e1" android:onClick="clickNeverLoseBall"/>
  <CheckBox android:id="@+id/checkbox_soundEffectsEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/checkbox_soundEffectsEnabled" android:textColor="#cbd5e1" android:onClick="clickSoundEffectsEnabled"/>
  <TextView android:id="@+id/text_highScoreLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/text_highScoreLabel" android:textColor="#cbd5e1"/>
  <TextView android:id="@+id/text_highScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#ffffff"/>
 </LinearLayout>
</ScrollView>
